<section class="fz-container fz-section fz-section--first">
  <div class="fz-section__head">
    <h2 class="fz-h2">{{ section.settings.heading }}</h2>
    <a class="fz-section__link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label }}</a>
  </div>
  <div class="fz-cats">
    {%- for block in section.blocks -%}
      {%- liquid
        assign col = block.settings.collection
        assign card_name = block.settings.title | default: col.title
        assign card_img = block.settings.image
        if card_img == blank and col != blank
          if col.featured_image != blank
            assign card_img = col.featured_image
          elsif col.products.first.featured_image != blank
            assign card_img = col.products.first.featured_image
          endif
        endif
      -%}
      <a
        class="fz-cat-card fz-cat-card--{{ block.settings.tint }}"
        href="{{ col.url | default: routes.all_products_collection_url }}"
        {{ block.shopify_attributes }}
      >
        <div class="fz-cat-card__name">{{ card_name }}</div>
        <div class="fz-cat-card__desc">{{ block.settings.description }}</div>
        {%- if card_img != blank -%}
          {{ card_img
            | image_url: width: 800
            | image_tag: class: 'fz-cat-card__img', widths: '400, 600, 800', loading: 'lazy', alt: card_name }}
        {%- else -%}
          {{ 'product-2' | placeholder_svg_tag: 'fz-cat-card__img' }}
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by ritual",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by ritual"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View everything"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "text", "id": "description", "label": "Description" },
        {
          "type": "select",
          "id": "tint",
          "label": "Tint",
          "options": [
            { "value": "mint", "label": "Mint" },
            { "value": "offwhite", "label": "Off-white" }
          ],
          "default": "mint"
        },
        { "type": "image_picker", "id": "image", "label": "Image override" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Shop by ritual",
      "blocks": [
        { "type": "category", "settings": { "description": "Cleanse, treat, renew", "tint": "mint" } },
        { "type": "category", "settings": { "description": "Stronger from the root", "tint": "offwhite" } },
        { "type": "category", "settings": { "description": "Daily protection, no white cast", "tint": "mint" } }
      ]
    }
  ]
}
{% endschema %}
