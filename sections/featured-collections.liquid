{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}
<section
  class="fz-feat-cols fz-container"
  data-feat-cols
  id="collections"
  {% if fz_section_padding != blank %}style="{{ fz_section_padding | strip }}"{% endif %}
>
  <header class="fz-feat-cols__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fz-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="fz-feat-cols__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div class="fz-feat-cols__grid">
        <div class="fz-feat-cols__hero" aria-live="polite">
          {%- for block in section.blocks -%}
            {%- liquid
              assign col = block.settings.collection
              assign feat_title = block.settings.title | default: col.title
              assign feat_url = col.url | default: routes.all_products_collection_url
              assign feat_img = block.settings.image
              assign feat_video = block.settings.video
              assign feat_product = block.settings.product

              if feat_img == blank and feat_product != blank and feat_product.featured_image != blank
                assign feat_img = feat_product.featured_image
              endif

              if feat_img == blank and col != blank
                if col.featured_image != blank
                  assign feat_img = col.featured_image
                elsif col.products.first.featured_image != blank
                  assign feat_img = col.products.first.featured_image
                endif
              endif

              if block.settings.description != blank
                assign feat_desc = block.settings.description
              elsif col != blank and col.description != blank
                assign feat_desc = col.description | strip_html | truncate: 180
              else
                assign feat_desc = ''
              endif
            -%}

            <article
              class="fz-feat-cols__panel{% if forloop.first %} is-active{% endif %}"
              data-feat-panel="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <div class="fz-feat-cols__panel-copy">
                {%- if block.settings.badge != blank -%}
                  <span class="fz-feat-cols__badge">{{ block.settings.badge }}</span>
                {%- endif -%}

                {%- if feat_title != blank -%}
                  <h3 class="fz-feat-cols__panel-title">{{ feat_title }}</h3>
                {%- endif -%}

                {%- if feat_desc != blank -%}
                  <p class="fz-feat-cols__panel-desc">{{ feat_desc }}</p>
                {%- endif -%}

                <a class="fz-btn fz-btn--light fz-feat-cols__panel-btn" href="{{ feat_url }}">
                  {{ block.settings.button_label | default: 'Explore collection' }}
                  <span class="fz-feat-cols__btn-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </div>

              <div class="fz-feat-cols__panel-media">
                <div class="fz-feat-cols__panel-frame">
                  {%- if feat_video != blank or feat_img != blank -%}
                    {%- render 'fz-media',
                      video: feat_video,
                      image: feat_img,
                      class_name: 'fz-feat-cols__panel-img',
                      alt: feat_title
                    -%}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'fz-feat-cols__panel-img' }}
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>

        <div class="fz-feat-cols__list" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            {%- liquid
              assign col = block.settings.collection
              assign item_title = block.settings.title | default: col.title
              assign item_label = block.settings.label | default: col.title
              assign item_url = col.url | default: routes.all_products_collection_url
              assign thumb = block.settings.thumbnail
              assign thumb_video = block.settings.thumbnail_video
              assign thumb_product = block.settings.product

              if thumb == blank and thumb_product != blank and thumb_product.featured_image != blank
                assign thumb = thumb_product.featured_image
              endif

              if thumb == blank and col != blank
                if col.featured_image != blank
                  assign thumb = col.featured_image
                elsif col.products.first.featured_image != blank
                  assign thumb = col.products.first.featured_image
                endif
              endif
            -%}

            <button
              type="button"
              class="fz-feat-cols__item{% if forloop.first %} is-active{% endif %}"
              data-feat-trigger="{{ forloop.index0 }}"
              data-feat-url="{{ item_url }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="feat-panel-{{ section.id }}-{{ forloop.index0 }}"
              id="feat-tab-{{ section.id }}-{{ forloop.index0 }}"
            >
              <span class="fz-feat-cols__item-thumb">
                {%- if thumb_video != blank or thumb != blank -%}
                  {%- render 'fz-media',
                    video: thumb_video,
                    image: thumb,
                    class_name: 'fz-feat-cols__item-thumb-media',
                    alt: ''
                  -%}
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag }}
                {%- endif -%}
              </span>

              <span class="fz-feat-cols__item-text">
                {%- if item_label != blank -%}
                  <span class="fz-feat-cols__item-label">{{ item_label }}</span>
                {%- endif -%}
                {%- if item_title != blank -%}
                  <span class="fz-feat-cols__item-title">{{ item_title }}</span>
                {%- endif -%}
              </span>

              <span class="fz-feat-cols__item-go" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="fz-feat-cols__actions">
      {%- if section.settings.secondary_label != blank -%}
        <a
          class="fz-btn fz-btn--outline fz-feat-cols__action"
          href="{{ section.settings.secondary_link | default: routes.collections_url }}"
        >
          {{ section.settings.secondary_label }}
        </a>
      {%- endif -%}
      {%- if section.settings.primary_label != blank -%}
        <a
          class="fz-btn fz-btn--primary fz-feat-cols__action"
          href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}"
        >
          {{ section.settings.primary_label }}
        </a>
      {%- endif -%}
    </div>
</section>

{% schema %}
{
  "name": "Featured collections",
  "tag": "section",
  "class": "fz-section-feat-cols",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured collections"
    },
    {
      "type": "header",
      "content": "Bottom buttons"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "View all collections"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop all products"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "product", "id": "product", "label": "Featured product", "info": "Used for imagery when no custom image is set." },
        { "type": "text", "id": "label", "label": "Category label", "default": "Skincare" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "badge", "label": "Badge", "default": "Clinically tested • Vegan" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore collection" },
        {
          "type": "header",
          "content": "Media overrides"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Featured image override",
          "info": "Used when no featured video is set."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Featured video",
          "info": "Plays instead of the featured image when set. Muted, looped autoplay."
        },
        {
          "type": "image_picker",
          "id": "thumbnail",
          "label": "List thumbnail override",
          "info": "Used when no list thumbnail video is set."
        },
        {
          "type": "video",
          "id": "thumbnail_video",
          "label": "List thumbnail video",
          "info": "Plays instead of the list thumbnail image when set. Muted, looped autoplay."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "label": "Skincare ritual",
            "title": "Exfoliating Serum",
            "description": "Targets blackheads, blemishes and uneven tone — the treatment step your routine has been missing.",
            "badge": "Niacinamide • BHA • Vegan",
            "product": "fauz-exfoliating-serum-targets-blackheads-blemishes-uneven-complexion"
          }
        },
        {
          "type": "collection",
          "settings": {
            "label": "Haircare",
            "title": "Stem Cell Shampoo",
            "description": "Anti-hair loss formula with biotin and stem cell actives — stronger from the root, every wash.",
            "badge": "Biotin • Stem cell • Daily use",
            "product": "fauz-stem-cell-shampoo-anti-hair-loss-regrowth-formula-with-biotin"
          }
        },
        {
          "type": "collection",
          "settings": {
            "label": "Sun care",
            "title": "Sun Screen SPF 60",
            "description": "High protection infused with aloe vera and caffeine — lightweight, no white cast, every day.",
            "badge": "SPF 60 • Aloe • Caffeine",
            "product": "fauz-sun-screen-spf-60-infused-with-aloe-vera-caffeine"
          }
        },
        {
          "type": "collection",
          "settings": {
            "label": "Daily cleanse",
            "title": "Gentle Cleanser",
            "description": "A gentle daily face wash that lifts away the day without stripping your skin barrier.",
            "badge": "Barrier-safe • All skin types",
            "product": "fauz-cleanser-gentle-daily-face-wash"
          }
        }
      ]
    }
  ]
}
{% endschema %}
