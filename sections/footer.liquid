{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}
<footer class="fz-footer"{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %}>
  {%- if section.settings.show_video -%}
    <div class="fz-footer__video" data-footer-video>
      <div class="fz-footer__video-media" aria-hidden="true">
        {%- if section.settings.video != blank -%}
          {%- render 'fz-media',
            video: section.settings.video,
            image: section.settings.video_poster,
            class_name: 'fz-footer__video-el',
            alt: section.settings.video_heading,
            loading: 'lazy',
            allow_placeholder: false -%}
        {%- elsif section.settings.video_url != blank -%}
          <video
            class="fz-footer__video-el fz-video-media"
            data-fz-video
            autoplay
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            tabindex="-1"
            {% if section.settings.video_poster != blank %}
              poster="{{ section.settings.video_poster | image_url: width: 1600 }}"
            {% endif %}
          >
            <source src="{{ section.settings.video_url }}" type="video/mp4">
          </video>
        {%- elsif section.settings.video_poster != blank -%}
          {{ section.settings.video_poster
            | image_url: width: 1600
            | image_tag: class: 'fz-footer__video-el', widths: '800, 1200, 1600', loading: 'lazy', alt: section.settings.video_heading }}
        {%- endif -%}
        <div class="fz-footer__video-overlay"></div>
      </div>

      {%- if section.settings.video_heading != blank or section.settings.video_eyebrow != blank -%}
        <div class="fz-footer__video-content" data-footer-video-content>
          {%- if section.settings.video_eyebrow != blank -%}
            <p class="fz-eyebrow fz-footer__video-eyebrow">{{ section.settings.video_eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.video_heading != blank -%}
            <h2 class="fz-footer__video-heading">{{ section.settings.video_heading }}</h2>
          {%- endif -%}
          {%- if section.settings.video_text != blank -%}
            <p class="fz-footer__video-text">{{ section.settings.video_text }}</p>
          {%- endif -%}
          {%- if section.settings.video_button_label != blank -%}
            <a
              class="fz-btn fz-btn--primary fz-btn--editorial fz-footer__video-cta"
              href="{{ section.settings.video_button_link | default: routes.all_products_collection_url }}"
            >{{ section.settings.video_button_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="fz-footer__main">
    <div class="fz-footer__inner">
      <div class="fz-footer__grid">
        <div class="fz-footer__col">
          <div class="fz-footer__heading">{{ section.settings.nav_heading }}</div>
          {%- if section.settings.nav_menu != blank -%}
            {%- for link in section.settings.nav_menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <a href="{{ routes.root_url }}">About us</a>
            <a href="{{ routes.blog_url }}">Journal</a>
            <a href="{{ routes.all_products_collection_url }}">Shop all</a>
          {%- endif -%}
        </div>

        <div class="fz-footer__col">
          <div class="fz-footer__heading">{{ section.settings.social_heading }}</div>
          {%- if section.settings.social_menu != blank -%}
            {%- for link in section.settings.social_menu.links -%}
              <a href="{{ link.url }}"{% if link.url contains 'http' %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            {%- if section.settings.social_instagram != blank -%}
              <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener noreferrer">Instagram</a>
            {%- endif -%}
            {%- if section.settings.social_facebook != blank -%}
              <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener noreferrer">Facebook</a>
            {%- endif -%}
            {%- if section.settings.social_tiktok != blank -%}
              <a href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener noreferrer">TikTok</a>
            {%- endif -%}
            {%- if section.settings.social_instagram == blank and section.settings.social_facebook == blank and section.settings.social_tiktok == blank -%}
              <a href="https://instagram.com" target="_blank" rel="noopener noreferrer">Instagram</a>
              <a href="https://facebook.com" target="_blank" rel="noopener noreferrer">Facebook</a>
              <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer">TikTok</a>
            {%- endif -%}
          {%- endif -%}
        </div>

        <div class="fz-footer__col">
          <div class="fz-footer__heading">{{ section.settings.policy_heading }}</div>
          {%- if section.settings.policy_menu != blank -%}
            {%- for link in section.settings.policy_menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <a href="/pages/faq">FAQs</a>
            <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy policy</a>
            <a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">Return policy</a>
          {%- endif -%}
        </div>

        <div class="fz-footer__col fz-footer__col--contact">
          {%- if section.settings.contact_address != blank -%}
            <p class="fz-footer__contact-line">{{ section.settings.contact_address }}</p>
          {%- endif -%}
          {%- if section.settings.contact_phone != blank -%}
            <p class="fz-footer__contact-line">
              {%- if section.settings.contact_phone_url != blank -%}
                <a href="{{ section.settings.contact_phone_url }}">{{ section.settings.contact_phone }}</a>
              {%- else -%}
                {{ section.settings.contact_phone }}
              {%- endif -%}
            </p>
          {%- endif -%}
          {%- if section.settings.contact_hours != blank -%}
            <p class="fz-footer__contact-line">{{ section.settings.contact_hours }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_giant_logo -%}
        <div class="fz-footer__brandmark">
          {% render 'logo-lockup', giant: true, show_tagline: section.settings.show_tagline %}
        </div>
      {%- endif -%}

      <div class="fz-footer__bottom">
        <span class="fz-footer__legal">© {{ 'now' | date: '%Y' }} {{ section.settings.legal_name }}. All rights reserved.</span>
        {%- if section.settings.hashtag != blank -%}
          <span class="fz-footer__hashtag">{{ section.settings.hashtag }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Video band"
    },
    {
      "type": "checkbox",
      "id": "show_video",
      "label": "Show video above footer",
      "default": true
    },
    {
      "type": "video",
      "id": "video",
      "label": "Footer video",
      "info": "Shopify-hosted video. Autoplays muted and loops."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "External MP4 URL",
      "info": "Fallback if no Shopify video is uploaded."
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Video poster / fallback image"
    },
    {
      "type": "text",
      "id": "video_eyebrow",
      "label": "Video eyebrow",
      "default": "The ritual"
    },
    {
      "type": "text",
      "id": "video_heading",
      "label": "Video heading",
      "default": "Your skin. Your ritual."
    },
    {
      "type": "textarea",
      "id": "video_text",
      "label": "Video supporting text",
      "default": "Begin with intention. Stay with consistency."
    },
    {
      "type": "text",
      "id": "video_button_label",
      "label": "Video button label",
      "default": "Start your routine"
    },
    {
      "type": "url",
      "id": "video_button_link",
      "label": "Video button link"
    },
    {
      "type": "header",
      "content": "Footer columns"
    },
    {
      "type": "text",
      "id": "nav_heading",
      "label": "Navigation heading",
      "default": "Quick navigation"
    },
    {
      "type": "link_list",
      "id": "nav_menu",
      "label": "Navigation menu"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "Follow us"
    },
    {
      "type": "link_list",
      "id": "social_menu",
      "label": "Social menu",
      "info": "Optional. Overrides individual social links below."
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "text",
      "id": "policy_heading",
      "label": "Policy heading",
      "default": "Terms & policy"
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Policy menu"
    },
    {
      "type": "textarea",
      "id": "contact_address",
      "label": "Contact address",
      "default": "Race Course Road, Lahore, Pakistan"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Contact phone",
      "default": "(+92) 329 0889049"
    },
    {
      "type": "url",
      "id": "contact_phone_url",
      "label": "Contact phone link",
      "info": "Optional tel: link"
    },
    {
      "type": "text",
      "id": "contact_hours",
      "label": "Contact hours",
      "default": "Monday – Friday, 10am – 6pm"
    },
    {
      "type": "header",
      "content": "Giant wordmark"
    },
    {
      "type": "checkbox",
      "id": "show_giant_logo",
      "label": "Show giant wordmark",
      "default": true
    },
    {
      "type": "text",
      "id": "giant_logo_text",
      "label": "Wordmark text",
      "default": "FAUZ"
    },
    {
      "type": "checkbox",
      "id": "show_tagline",
      "label": "Show tagline under wordmark",
      "default": true
    },
    {
      "type": "text",
      "id": "tagline_you",
      "label": "Tagline — line 1",
      "default": "YOU ARE"
    },
    {
      "type": "text",
      "id": "tagline_emphasis",
      "label": "Tagline — emphasis",
      "default": "Unique"
    },
    {
      "type": "text",
      "id": "legal_name",
      "label": "Legal name",
      "default": "Fauz Cosmetics"
    },
    {
      "type": "text",
      "id": "hashtag",
      "label": "Hashtag",
      "default": "#NeverCompare"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    }
  ]
}
{% endschema %}
