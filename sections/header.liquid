<div class="fz-header-wrap" data-header>
  <header class="fz-header">
    <button
      type="button"
      class="fz-menu-toggle"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="FzMobileNav"
      aria-label="Menu"
    >
      <span></span><span></span><span></span>
    </button>

    <nav class="fz-header__nav" aria-label="Main navigation">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">Shop</a>
        <a href="{{ section.settings.collections_link | default: routes.collections_url }}">Collections</a>
        <a href="{{ section.settings.about_link | default: '/pages/about' }}">About</a>
        <a href="{{ section.settings.journal_link | default: routes.blogs_url }}">Journal</a>
      {%- endif -%}
    </nav>

    <a href="{{ routes.root_url }}" class="fz-logo" aria-label="{{ shop.name }} — home">
      {% render 'logo-lockup' %}
    </a>

    <div class="fz-header__right">
      <a href="{{ routes.search_url }}" class="fz-header__icon-link" aria-label="Search">
        <span class="fz-header__icon-label">Search</span>
      </a>
      <a href="{{ routes.account_url }}" class="fz-header__icon-link" aria-label="Account">
        <span class="fz-header__icon-label">Account</span>
      </a>
      <button type="button" class="fz-cart-toggle" data-cart-open aria-haspopup="dialog">
        Cart · <span data-cart-count>{{ cart.item_count }}</span>
      </button>
    </div>
  </header>

  <nav class="fz-mobile-nav" id="FzMobileNav" aria-label="Mobile navigation">
    {%- if section.settings.menu != blank -%}
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    {%- else -%}
      <a href="{{ section.settings.shop_link | default: routes.all_products_collection_url }}">Shop</a>
      <a href="{{ section.settings.collections_link | default: routes.collections_url }}">Collections</a>
      <a href="{{ section.settings.about_link | default: '/pages/about' }}">About</a>
      <a href="{{ section.settings.journal_link | default: routes.blogs_url }}">Journal</a>
    {%- endif -%}
    <a href="{{ routes.search_url }}">Search</a>
    <a href="{{ routes.account_url }}">Account</a>
  </nav>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Leave empty to use the default Shop / Collections / About / Journal links."
    },
    {
      "type": "url",
      "id": "shop_link",
      "label": "Shop link",
      "info": "Used when no menu is set."
    },
    {
      "type": "url",
      "id": "collections_link",
      "label": "Collections link"
    },
    {
      "type": "url",
      "id": "about_link",
      "label": "About link"
    },
    {
      "type": "url",
      "id": "journal_link",
      "label": "Journal link"
    }
  ]
}
{% endschema %}
