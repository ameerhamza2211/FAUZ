{%- liquid
  assign bg_type = section.settings.background_type | default: 'none'
  assign bg_video = blank
  assign bg_image = blank
  assign has_bg_media = false

  if bg_type == 'video' and section.settings.video != blank
    assign bg_video = section.settings.video
    assign bg_image = section.settings.image
    assign has_bg_media = true
  elsif bg_type == 'image' and section.settings.image != blank
    assign bg_image = section.settings.image
    assign has_bg_media = true
  endif

  assign hero_alt = section.settings.image.alt | default: shop.name

  assign mobile_bg_type = section.settings.mobile_background_type | default: 'inherit'
  assign mobile_bg_video = blank
  assign mobile_bg_image = blank
  assign use_mobile_layer = false
  assign has_mobile_media = false

  if mobile_bg_type == 'video' and section.settings.mobile_video != blank
    assign mobile_bg_video = section.settings.mobile_video
    assign mobile_bg_image = section.settings.mobile_image
    if mobile_bg_image == blank
      assign mobile_bg_image = section.settings.image
    endif
    assign use_mobile_layer = true
    assign has_mobile_media = true
  elsif mobile_bg_type == 'image' and section.settings.mobile_image != blank
    assign mobile_bg_image = section.settings.mobile_image
    assign use_mobile_layer = true
    assign has_mobile_media = true
  elsif mobile_bg_type == 'video' and section.settings.mobile_image != blank
    assign mobile_bg_image = section.settings.mobile_image
    assign use_mobile_layer = true
    assign has_mobile_media = true
  endif

  assign mobile_hero_alt = section.settings.mobile_image.alt | default: hero_alt

  assign grad_enabled = section.settings.gradient_overlay_enable
  assign grad_style = section.settings.gradient_style | default: 'bottom_fade'
  assign grad_c1 = section.settings.gradient_color_1 | default: '#E8EAE9'
  assign grad_c2 = section.settings.gradient_color_2 | default: '#C1DBD8'
  assign grad_opacity = section.settings.gradient_opacity | default: 85 | times: 1.0 | divided_by: 100

  assign grad_c1_soft = grad_c1 | color_modify: 'alpha', 0.94
  assign grad_c1_mid = grad_c1 | color_modify: 'alpha', 0.62
  assign grad_c1_light = grad_c1 | color_modify: 'alpha', 0.14
  assign grad_c1_clear = grad_c1 | color_modify: 'alpha', 0
  assign grad_c1_side = grad_c1 | color_modify: 'alpha', 0.55
  assign grad_c2_glow = grad_c2 | color_modify: 'alpha', 0.55
  assign grad_c2_soft = grad_c2 | color_modify: 'alpha', 0.35
  assign grad_c1_floor = grad_c1 | color_modify: 'alpha', 0.95
-%}

{% style %}
  #shopify-section-{{ section.id }} .fz-hero-premium {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: {{ grad_c1 }};
  }
  @supports (min-height: 100svh) {
    #shopify-section-{{ section.id }} .fz-hero-premium { min-height: 100svh; }
  }

  #shopify-section-{{ section.id }} .fz-hero-premium__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .fz-hero-premium__media .fz-hero-premium__bg-media,
  #shopify-section-{{ section.id }} .fz-hero-premium__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  #shopify-section-{{ section.id }} .fz-hero-premium__media--mobile {
    display: none;
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .fz-hero-premium__media--hide-mobile {
      display: none;
    }

    #shopify-section-{{ section.id }} .fz-hero-premium__media--mobile {
      display: block;
    }

    #shopify-section-{{ section.id }} .fz-hero-premium__media--mobile .fz-hero-premium__bg-media,
    #shopify-section-{{ section.id }} .fz-hero-premium__media--mobile video {
      object-position: center center;
    }

    #shopify-section-{{ section.id }} .fz-hero-premium--has-media {
      min-height: auto;
      flex-direction: column;
      align-items: stretch;
      overflow: visible;
      padding-top: 0;
      background: transparent;
    }

    #shopify-section-{{ section.id }} .fz-hero-premium--has-media .fz-hero-premium__media {
      position: relative;
      inset: auto;
      width: 100%;
      height: 100svh;
      min-height: 100svh;
      max-height: none;
      aspect-ratio: auto;
    }

    @supports (height: 100dvh) {
      #shopify-section-{{ section.id }} .fz-hero-premium--has-media .fz-hero-premium__media {
        height: 100dvh;
        min-height: 100dvh;
      }
    }

    #shopify-section-{{ section.id }} .fz-hero-premium--has-media .fz-hero-premium__scrim {
      display: none;
    }

    #shopify-section-{{ section.id }} .fz-hero-premium--has-media .fz-hero-premium__inner {
      padding: var(--fz-section-y-lg) var(--fz-gutter);
      background: {{ grad_c1 }};
    }
  }

  #shopify-section-{{ section.id }} .fz-hero-premium__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .fz-hero-premium__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: {{ grad_opacity }};
    {%- case grad_style -%}
      {%- when 'left_fade' -%}
    background: linear-gradient(to right, {{ grad_c1_soft }} 0%, {{ grad_c1_light }} 42%, {{ grad_c1_clear }} 72%);
      {%- when 'diagonal' -%}
    background:
      linear-gradient(135deg, {{ grad_c1_soft }} 0%, {{ grad_c2_glow }} 48%, {{ grad_c1_clear }} 100%);
      {%- when 'radial' -%}
    background:
      radial-gradient(ellipse 85% 70% at 72% 38%, {{ grad_c2_glow }} 0%, {{ grad_c1_clear }} 62%),
      radial-gradient(ellipse 55% 45% at 18% 82%, {{ grad_c1_floor }} 0%, {{ grad_c1_clear }} 72%);
      {%- when 'linear' -%}
    background: linear-gradient(180deg, {{ grad_c1 }} 0%, {{ grad_c2 }} 100%);
      {%- when 'full_blend' -%}
    background:
      radial-gradient(ellipse 80% 60% at 70% 40%, {{ grad_c2_glow }} 0%, {{ grad_c1_clear }} 65%),
      radial-gradient(ellipse 50% 40% at 20% 80%, {{ grad_c1_floor }} 0%, {{ grad_c1_clear }} 70%),
      linear-gradient(180deg, {{ grad_c1 }} 0%, {{ grad_c2 }} 100%);
      {%- else -%}
    background:
      linear-gradient(to top, {{ grad_c1_soft }} 0%, {{ grad_c1_mid }} 30%, {{ grad_c1_light }} 58%, {{ grad_c1_clear }} 100%),
      linear-gradient(to right, {{ grad_c1_side }} 0%, {{ grad_c1_clear }} 55%);
    {%- endcase -%}
  }

  #shopify-section-{{ section.id }} .fz-hero-premium__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--fz-content-max);
    margin: 0 auto;
    padding: 0 var(--fz-gutter) var(--fz-section-y-lg);
  }

  #shopify-section-{{ section.id }} .fz-hero-premium__copy {
    max-width: 42rem;
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .fz-hero-premium__inner { padding: 0 var(--fz-gutter) var(--fz-section-y); }
  }
{% endstyle %}

{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}
<section class="fz-hero-premium{% if has_bg_media or has_mobile_media %} fz-hero-premium--has-media{% endif %}" data-hero{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %}>
  {%- if has_bg_media -%}
    <div class="fz-hero-premium__media fz-hero-premium__media--desktop{% if use_mobile_layer %} fz-hero-premium__media--hide-mobile{% endif %}" aria-hidden="true">
      {%- render 'fz-media',
        video: bg_video,
        image: bg_image,
        class_name: 'fz-hero-premium__bg-media',
        alt: hero_alt,
        loading: 'eager',
        allow_placeholder: false -%}
    </div>
  {%- endif -%}

  {%- if use_mobile_layer and has_mobile_media -%}
    <div class="fz-hero-premium__media fz-hero-premium__media--mobile" aria-hidden="true">
      {%- render 'fz-media',
        video: mobile_bg_video,
        image: mobile_bg_image,
        class_name: 'fz-hero-premium__bg-media',
        alt: mobile_hero_alt,
        loading: 'eager',
        allow_placeholder: false -%}
    </div>
  {%- endif -%}

  {%- unless has_bg_media or has_mobile_media -%}
    <div class="fz-hero-premium__bg" aria-hidden="true">
      <div class="fz-hero-premium__grain"></div>
    </div>
  {%- endunless -%}

  {%- if grad_enabled -%}
    <div class="fz-hero-premium__scrim" aria-hidden="true"></div>
  {%- endif -%}

  <div class="fz-hero-premium__inner">
    <div class="fz-hero-premium__copy">
      <p class="fz-eyebrow fz-hero-premium__eyebrow" data-hero-reveal>{{ section.settings.eyebrow }}</p>
      <h1 class="fz-hero-premium__h1" data-hero-reveal>
        {{ section.settings.heading_line_1 }}<br>
        <em class="fz-hero-premium__em">{{ section.settings.heading_emphasis }}</em>
      </h1>
      <p class="fz-hero-premium__text" data-hero-reveal>{{ section.settings.text }}</p>
      <div class="fz-hero-premium__actions" data-hero-reveal>
        {%- if section.settings.button_label != blank -%}
          <a
            class="fz-btn fz-btn--primary fz-btn--editorial"
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          >{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Fauz Cosmetics"
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Headline — line 1",
      "default": "Skin that feels"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Headline — emphasis",
      "default": "like you."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting copy",
      "default": "Clinically considered formulas for modern skin — clean, effective, and designed for daily ritual."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary CTA label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary CTA link"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background type",
      "options": [
        { "value": "none", "label": "None (gradient)" },
        { "value": "image", "label": "Background image" },
        { "value": "video", "label": "Background video" }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Used when Background type is Background image. Also used as video poster."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video",
      "info": "Used when Background type is Background video. Plays muted and looped."
    },
    {
      "type": "header",
      "content": "Mobile background"
    },
    {
      "type": "paragraph",
      "content": "Optional separate banner for phones and tablets (900px and below). Choose a type, then upload the mobile image or video."
    },
    {
      "type": "select",
      "id": "mobile_background_type",
      "label": "Mobile background type",
      "options": [
        { "value": "inherit", "label": "Use desktop background" },
        { "value": "image", "label": "Mobile image" },
        { "value": "video", "label": "Mobile video" }
      ],
      "default": "inherit"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile banner image",
      "info": "Portrait or square crops work best on mobile. Also used as poster when mobile video is set."
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile banner video",
      "info": "Used when Mobile background type is Mobile video. Vertical or square clips work best."
    },
    {
      "type": "header",
      "content": "Gradient overlay"
    },
    {
      "type": "paragraph",
      "content": "Customize the gradient over your banner. Defaults match FAUZ theme colors (off-white #E8EAE9 and mint #C1DBD8) — change them to any colors you like."
    },
    {
      "type": "checkbox",
      "id": "gradient_overlay_enable",
      "label": "Show gradient overlay",
      "default": true
    },
    {
      "type": "select",
      "id": "gradient_style",
      "label": "Gradient style",
      "options": [
        { "value": "bottom_fade", "label": "Bottom fade — best for text over photo/video" },
        { "value": "left_fade", "label": "Left fade" },
        { "value": "diagonal", "label": "Diagonal blend" },
        { "value": "radial", "label": "Radial glow" },
        { "value": "linear", "label": "Simple top to bottom" },
        { "value": "full_blend", "label": "Full blend — no photo (gradient only)" }
      ],
      "default": "bottom_fade"
    },
    {
      "type": "color",
      "id": "gradient_color_1",
      "label": "Gradient color 1",
      "default": "#E8EAE9",
      "info": "Primary tone — theme off-white by default."
    },
    {
      "type": "color",
      "id": "gradient_color_2",
      "label": "Gradient color 2",
      "default": "#C1DBD8",
      "info": "Secondary tone — theme mint by default."
    },
    {
      "type": "range",
      "id": "gradient_opacity",
      "label": "Overlay strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 85
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
