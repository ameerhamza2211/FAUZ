{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}
<section class="fz-ingredients" data-ingredients{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %}>
  <div class="fz-ingredients__layout">
    <div class="fz-ingredients__sticky">
      <p class="fz-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="fz-ingredients__heading">{{ section.settings.heading }}</h2>
      <p class="fz-ingredients__lead">{{ section.settings.text }}</p>

      <div class="fz-ingredients__names" data-ingredient-names>
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="fz-ingredients__name{% if forloop.first %} is-active{% endif %}"
            data-ingredient-trigger="{{ forloop.index0 }}"
            {{ block.shopify_attributes }}
          >{{ block.settings.name }}</button>
        {%- endfor -%}
      </div>
    </div>

    <div class="fz-ingredients__panels">
      {%- for block in section.blocks -%}
        <article
          class="fz-ingredients__panel{% if forloop.first %} is-active{% endif %}"
          data-ingredient-panel="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="fz-ingredients__panel-media" data-ingredient-media>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image
                | image_url: width: 1200
                | image_tag: class: 'fz-ingredients__panel-img', widths: '600, 900, 1200', loading: 'lazy', alt: block.settings.name }}
            {%- else -%}
              {{ 'product-2' | placeholder_svg_tag: 'fz-ingredients__panel-img' }}
            {%- endif -%}
          </div>
          <div class="fz-ingredients__panel-copy">
            <h3 class="fz-ingredients__panel-title">{{ block.settings.name }}</h3>
            <p class="fz-ingredients__panel-text">{{ block.settings.description }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredient story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Inside the formula"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Actives with intention"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Lead text",
      "default": "Every ingredient is chosen for performance, tolerance, and the quiet confidence of skin that feels balanced."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Niacinamide"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Helps refine texture, support the barrier, and even tone without irritation."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Ingredient story",
      "blocks": [
        {
          "type": "ingredient",
          "settings": {
            "name": "Niacinamide",
            "description": "Helps refine texture, support the barrier, and even tone without irritation."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Hyaluronic acid",
            "description": "Draws moisture into the skin for plump, comfortable hydration throughout the day."
          }
        },
        {
          "type": "ingredient",
          "settings": {
            "name": "Ceramides",
            "description": "Reinforce the skin barrier so your routine protects as much as it perfects."
          }
        }
      ]
    }
  ]
}
{% endschema %}
