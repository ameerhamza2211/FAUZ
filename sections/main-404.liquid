{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}

{% render 'fz-page-hero',
  eyebrow: '404',
  title: 'Page not found',
  text: "The page you're looking for doesn't exist — but your ritual does.",
  tone: 'mint',
  compact: true
%}

<div class="fz-page-shell fz-page-shell--narrow" style="text-align: center;{% if fz_section_padding != blank %} {{ fz_section_padding | strip }}{% endif %}" data-page-reveal>
  <a class="fz-btn fz-btn--primary fz-btn--primary-accent" href="{{ routes.all_products_collection_url }}">Shop the collection</a>
</div>

{% schema %}
{
  "name": "404",
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ]
}
{% endschema %}
