{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}
<article class="fz-page"{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %}>
  <h1 class="fz-page__title">{{ article.title }}</h1>
  <p class="fz-empty-note" style="margin-bottom: 32px;">{{ article.published_at | date: '%B %e, %Y' }}</p>
  {%- if article.image -%}
    {{ article.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: article.title, style: 'border-radius: 16px; margin-bottom: 32px;' }}
  {%- endif -%}
  <div class="fz-page__body">{{ article.content }}</div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    }
  ]
}
{% endschema %}
