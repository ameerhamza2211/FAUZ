{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}

{%- liquid
  assign collection_title = collection.title
  if collection.handle == 'all'
    assign collection_title = 'Shop all'
  endif
-%}

{% render 'fz-page-hero',
  eyebrow: section.settings.eyebrow,
  title: collection_title,
  text: collection.description | strip_html,
  tone: section.settings.hero_tone,
  compact: true
%}

<div class="fz-collection"{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %} data-page-reveal>
  {%- if section.settings.show_filters -%}
    <div class="fz-chips">
      <a class="fz-chip{% if collection.handle == 'all' %} fz-chip--active{% endif %}" href="{{ routes.all_products_collection_url }}">All</a>
      {%- liquid
        assign filter_cols = section.settings.filter_collections
        if filter_cols == blank or filter_cols.count == 0
          assign fallback_handles = 'skincare,haircare,sun-care' | split: ','
        endif
      -%}
      {%- if fallback_handles -%}
        {%- for h in fallback_handles -%}
          {%- assign fc = collections[h] -%}
          {%- if fc != blank -%}
            <a class="fz-chip{% if collection.handle == fc.handle %} fz-chip--active{% endif %}" href="{{ fc.url }}">{{ fc.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for fc in filter_cols -%}
          <a class="fz-chip{% if collection.handle == fc.handle %} fz-chip--active{% endif %}" href="{{ fc.url }}">{{ fc.title }}</a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="fz-collection__toolbar">
    <span class="fz-collection__count">{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</span>
    {%- if collection.sort_options.size > 0 -%}
      <div class="fz-collection__sort-wrap">
        <label class="fz-collection__sort-label" for="FzCollectionSort">Sort</label>
        <select id="FzCollectionSort" class="fz-collection__sort" data-collection-sort aria-label="Sort products">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}"{% if option.value == collection.sort_by %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </div>
    {%- endif -%}
  </div>

  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="fz-collection__grid">
      {%- for product in collection.products -%}
        {% render 'product-card', card_product: product %}
      {%- else -%}
        <p class="fz-empty-note">No products here yet.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <nav class="fz-pagination" aria-label="Pagination">
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}">Prev</a>
        {%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}
            <a href="{{ part.url }}">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="fz-pagination__current">{{ part.title }}</span>
          {%- else -%}
            <span>{{ part.title }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}">Next</a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The collection"
    },
    {
      "type": "select",
      "id": "hero_tone",
      "label": "Hero tone",
      "options": [
        { "value": "default", "label": "Off-white" },
        { "value": "mint", "label": "Mint" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show category filter pills",
      "default": true
    },
    {
      "type": "collection_list",
      "id": "filter_collections",
      "label": "Filter collections"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 6,
      "max": 48,
      "step": 3,
      "default": 24
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ]
}
{% endschema %}
