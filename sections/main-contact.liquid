{%- liquid
  assign contact_title = section.settings.title
  if contact_title == blank
    assign contact_title = page.title | default: 'Contact us'
  endif
-%}

{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}

<section
  class="fz-contact-page fz-container"
  {% if fz_section_padding != blank %}style="{{ fz_section_padding | strip }}"{% endif %}
  data-page-reveal
>
  <header class="fz-contact-page__head">
    {%- if section.settings.eyebrow != blank -%}
      <p class="fz-contact-page__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="fz-contact-page__title">{{ contact_title }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="fz-contact-page__intro">{{ section.settings.intro }}</p>
    {%- endif -%}
  </header>

  <div class="fz-contact-page__grid">
    <aside class="fz-contact-page__info">
      <div class="fz-contact-page__card fz-contact-page__card--info">
        {%- if section.settings.info_heading != blank -%}
          <h2 class="fz-contact-page__card-title">{{ section.settings.info_heading }}</h2>
        {%- endif -%}

        {%- if section.settings.info_text != blank -%}
          <p class="fz-contact-page__card-text">{{ section.settings.info_text }}</p>
        {%- elsif page.content != blank -%}
          <div class="fz-contact-page__card-text fz-prose">{{ page.content }}</div>
        {%- endif -%}

        {%- assign contact_blocks = section.blocks | where: 'type', 'contact_item' -%}
        {%- if contact_blocks.size > 0 -%}
          <ul class="fz-contact-page__list">
            {%- for block in contact_blocks -%}
              <li class="fz-contact-page__item" {{ block.shopify_attributes }}>
                <span class="fz-contact-page__item-icon">
                  {%- if block.settings.custom_icon != blank -%}
                    {{ block.settings.custom_icon | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40, 80', alt: '' }}
                  {%- else -%}
                    {% render 'fz-contact-icon', icon: block.settings.icon %}
                  {%- endif -%}
                </span>
                <div class="fz-contact-page__item-body">
                  {%- if block.settings.label != blank -%}
                    <span class="fz-contact-page__item-label">{{ block.settings.label }}</span>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    {%- liquid
                      assign item_link = block.settings.link
                      if item_link == blank and block.settings.icon == 'email'
                        assign item_link = block.settings.text | strip | prepend: 'mailto:'
                      elsif item_link == blank and block.settings.icon == 'phone'
                        assign item_link = block.settings.text | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | prepend: 'tel:'
                      endif
                    -%}
                    {%- if item_link != blank -%}
                      <a class="fz-contact-page__item-value" href="{{ item_link }}">{{ block.settings.text | newline_to_br }}</a>
                    {%- else -%}
                      <span class="fz-contact-page__item-value">{{ block.settings.text | newline_to_br }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- assign social_blocks = section.blocks | where: 'type', 'social_link' -%}
        {%- if social_blocks.size > 0 -%}
          <div class="fz-contact-page__social">
            {%- for block in social_blocks -%}
              {%- if block.settings.url != blank -%}
                <a
                  class="fz-contact-page__social-link"
                  href="{{ block.settings.url }}"
                  {{ block.shopify_attributes }}
                  {% if block.settings.open_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                  aria-label="{{ block.settings.label | default: 'Social link' | escape }}"
                >
                  {%- if block.settings.custom_icon != blank -%}
                    {{ block.settings.custom_icon | image_url: width: 80 | image_tag: loading: 'lazy', widths: '40, 80', alt: '' }}
                  {%- else -%}
                    {% render 'fz-contact-icon', icon: block.settings.icon %}
                  {%- endif -%}
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.show_faq_cta -%}
        <div class="fz-contact-page__card fz-contact-page__card--faq">
          {%- if section.settings.help_text != blank -%}
            <p class="fz-contact-page__card-text">{{ section.settings.help_text }}</p>
          {%- endif -%}
          <a class="fz-btn fz-btn--outline" href="{{ section.settings.faq_link | default: '/pages/faq' }}">
            {{ section.settings.faq_label | default: 'View FAQs' }}
          </a>
        </div>
      {%- endif -%}
    </aside>

    <div class="fz-contact-page__form-wrap">
      <div class="fz-contact-page__card fz-contact-page__card--form">
        {%- if section.settings.form_heading != blank -%}
          <h2 class="fz-contact-page__card-title">{{ section.settings.form_heading }}</h2>
        {%- endif -%}

        {%- form 'contact', class: 'fz-contact-page__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="fz-contact-page__success" role="status">
              {{ section.settings.success_message | default: "Thanks for reaching out — we'll get back to you soon." }}
            </div>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="fz-contact-page__errors" role="alert">
              {%- for field in form.errors -%}
                <div>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</div>
              {%- endfor -%}
            </div>
          {%- endif -%}

          <div class="fz-contact-page__field">
            <label class="visually-hidden" for="ContactName">{{ section.settings.name_label }}</label>
            <input
              class="fz-contact-page__input"
              id="ContactName"
              type="text"
              name="contact[name]"
              autocomplete="name"
              value="{{ form.name }}"
              placeholder="{{ section.settings.name_placeholder }}"
            >
          </div>

          <div class="fz-contact-page__field-row">
            <div class="fz-contact-page__field">
              <label class="visually-hidden" for="ContactEmail">{{ section.settings.email_label }}</label>
              <input
                class="fz-contact-page__input"
                id="ContactEmail"
                type="email"
                name="contact[email]"
                autocomplete="email"
                required
                value="{{ form.email }}"
                placeholder="{{ section.settings.email_placeholder }}"
              >
            </div>

            {%- if section.settings.show_phone -%}
              <div class="fz-contact-page__field">
                <label class="visually-hidden" for="ContactPhone">{{ section.settings.phone_label }}</label>
                <input
                  class="fz-contact-page__input"
                  id="ContactPhone"
                  type="tel"
                  name="contact[phone]"
                  autocomplete="tel"
                  placeholder="{{ section.settings.phone_placeholder }}"
                >
              </div>
            {%- endif -%}
          </div>

          <div class="fz-contact-page__field">
            <label class="visually-hidden" for="ContactMessage">{{ section.settings.message_label }}</label>
            <textarea
              class="fz-contact-page__input fz-contact-page__input--area"
              id="ContactMessage"
              name="contact[body]"
              required
              placeholder="{{ section.settings.message_placeholder }}"
            >{{ form.body }}</textarea>
          </div>

          <button type="submit" class="fz-contact-page__submit">
            {{ section.settings.button_label | default: 'Send message' }}
          </button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

