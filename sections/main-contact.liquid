{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}
<div class="fz-page"{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %}>
  <h1 class="fz-page__title">{{ page.title | default: 'Contact us' }}</h1>
  {%- if page.content != blank -%}
    <div class="fz-page__body" style="margin-bottom: 32px;">{{ page.content }}</div>
  {%- endif -%}

  {%- form 'contact', class: 'fz-form' -%}
    {%- if form.posted_successfully? -%}
      <div class="fz-form__success">Thanks for reaching out — we'll get back to you soon.</div>
    {%- endif -%}
    {%- if form.errors -%}
      <div class="fz-form__errors">
        {%- for field in form.errors -%}
          <div>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</div>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <input class="fz-input" type="text" name="contact[name]" placeholder="Name" autocomplete="name" value="{{ form.name }}">
    <input class="fz-input" type="email" name="contact[email]" placeholder="Email" autocomplete="email" required value="{{ form.email }}">
    <textarea class="fz-input" name="contact[body]" placeholder="Message" required>{{ form.body }}</textarea>
    <div><button type="submit" class="fz-btn fz-btn--primary fz-btn--primary-accent">Send message</button></div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact",
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    }
  ]
}
{% endschema %}
