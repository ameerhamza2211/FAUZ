{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}

{% render 'fz-page-hero',
  eyebrow: 'Browse',
  title: 'Collections',
  text: 'Explore skincare, haircare, sun care, and more.',
  tone: 'mint',
  compact: true
%}

<div class="fz-page-shell"{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %} data-page-reveal>
  <div class="fz-cats">
    {%- for c in collections -%}
      {%- unless c.handle == 'frontpage' -%}
        <a class="fz-cat-card fz-cat-card--{% cycle 'mint', 'offwhite' %}" href="{{ c.url }}">
          <div class="fz-cat-card__name">{{ c.title }}</div>
          <div class="fz-cat-card__desc">{{ c.products_count }} {% if c.products_count == 1 %}product{% else %}products{% endif %}</div>
          {%- liquid
            assign cimg = c.featured_image | default: c.products.first.featured_image
          -%}
          {%- if cimg != blank -%}
            {{ cimg | image_url: width: 800 | image_tag: class: 'fz-cat-card__img', loading: 'lazy', alt: c.title }}
          {%- endif -%}
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ]
}
{% endschema %}
