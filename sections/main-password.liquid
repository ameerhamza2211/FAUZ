{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}
<div class="fz-password"{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %}>
  {% render 'logo-lockup' %}
  <p class="fz-hero__text" style="text-align: center;">We're getting our ritual ready. Check back soon.</p>
  {%- form 'storefront_password', class: 'fz-form' -%}
    <input
      class="fz-input"
      type="password"
      name="password"
      placeholder="Store password"
      aria-label="Store password"
    >
    <button type="submit" class="fz-btn fz-btn--primary fz-btn--primary-accent">Enter</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    }
  ]
}
{% endschema %}
