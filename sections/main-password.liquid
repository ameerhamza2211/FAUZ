<div class="fz-password">
  {% render 'logo-lockup' %}
  <p class="fz-hero__text" style="text-align: center;">We're getting our ritual ready. Check back soon.</p>
  {%- form 'storefront_password', class: 'fz-form' -%}
    <input
      class="fz-input"
      type="password"
      name="password"
      placeholder="Store password"
      aria-label="Store password"
    >
    <button type="submit" class="fz-btn fz-btn--primary fz-btn--primary-accent">Enter</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
