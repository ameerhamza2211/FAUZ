{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}

{% render 'fz-page-hero',
  eyebrow: section.settings.eyebrow,
  title: policy.title,
  text: section.settings.intro,
  tone: section.settings.hero_tone,
  compact: true
%}

<div class="fz-page-shell fz-page-shell--legal"{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %}>
  <div class="fz-page-shell__card" data-page-reveal>
    <div class="fz-page-meta">
      <span class="fz-page-meta__item">{{ shop.name }}</span>
      {%- if section.settings.show_updated -%}
        <span class="fz-page-meta__item">Last updated {{ 'now' | date: '%B %Y' }}</span>
      {%- endif -%}
    </div>
    <div class="fz-prose rte">
      {{ policy.body }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Policy",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Legal"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Clear, readable information about how we protect your privacy and handle your orders."
    },
    {
      "type": "select",
      "id": "hero_tone",
      "label": "Hero tone",
      "options": [
        { "value": "default", "label": "Off-white" },
        { "value": "mint", "label": "Mint" }
      ],
      "default": "default"
    },
    {
      "type": "checkbox",
      "id": "show_updated",
      "label": "Show last updated",
      "default": true
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ]
}
{% endschema %}
