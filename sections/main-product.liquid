{%- liquid
  assign variant = product.selected_or_first_available_variant

  assign product_collection = ''
  for c in product.collections
    unless c.handle == 'all' or c.handle == 'frontpage'
      assign product_collection = c
      break
    endunless
  endfor

  assign tint = 'offwhite'
  if product_collection.handle == 'sun-care'
    assign tint = 'mint'
  endif
  if product.metafields.custom.card_tint != blank
    assign tint = product.metafields.custom.card_tint
  endif

  assign size = product.metafields.custom.size.value
  assign benefits = product.metafields.custom.benefits.value
  assign how_to = product.metafields.custom.how_to_use.value
  assign badges = product.metafields.custom.badges.value
  assign blurb = product.metafields.custom.blurb.value

  assign desc_html = blurb
  if desc_html == blank and product.description != blank
    assign desc_html = product.description
  endif

  assign title_parts = product.title | split: ' – '
  if title_parts.size == 1
    assign title_parts = product.title | split: ' - '
  endif
  if title_parts.size > 1
    assign product_title_short = title_parts[0]
    assign product_title_detail = title_parts[1]
  else
    assign product_title_short = product.title
    assign product_title_detail = ''
  endif
-%}

{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}

<div class="fz-product fz-product--editorial"{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %} data-page-reveal>
  <nav class="fz-product__crumbs" aria-label="Breadcrumb">
    <a href="{{ routes.all_products_collection_url }}">shop</a>
    <span class="fz-product__crumbs-sep">/</span>
    {%- if product_collection != blank -%}
      <a href="{{ product_collection.url }}">{{ product_collection.title | downcase }}</a>
      <span class="fz-product__crumbs-sep">/</span>
    {%- endif -%}
    <span class="fz-product__crumbs-current" aria-current="page">{{ product.title | downcase }}</span>
  </nav>

  <div class="fz-product__layout">
    <div class="fz-product__gallery">
      <div class="fz-product__gallery-inner">
        {%- if product.images.size > 1 -%}
          <div class="fz-product__thumbs-col" data-gallery-thumbs>
            {%- for image in product.images -%}
              <button
                type="button"
                class="fz-product__thumb{% if forloop.first %} is-active{% endif %}"
                data-thumb="{{ image | image_url: width: 1200 }}"
                data-thumb-srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w"
                aria-label="View image {{ forloop.index }}"
              >
                <img src="{{ image | image_url: width: 160 }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="72" height="72" alt="">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="fz-product__stage" data-gallery-stage>
          <div class="fz-product__main{% if tint == 'mint' %} fz-product__main--mint{% endif %}">
            {%- if product.featured_image -%}
              {%- assign main_alt = product.featured_image.alt | default: product.title -%}
              <img
                src="{{ product.featured_image | image_url: width: 1200 }}"
                srcset="{{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w, {{ product.featured_image | image_url: width: 1200 }} 1200w"
                sizes="(max-width: 900px) 100vw, 50vw"
                class="fz-product__main-img"
                data-main-image
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
                alt="{{ main_alt | escape }}"
              >
            {%- else -%}
              {{ 'product-4' | placeholder_svg_tag: 'fz-product__main-img' }}
            {%- endif -%}
          </div>

          {%- if product.images.size > 1 -%}
            <div class="fz-product__gallery-nav">
              <button type="button" class="fz-product__gallery-btn" data-gallery-prev aria-label="Previous image">←</button>
              <button type="button" class="fz-product__gallery-btn" data-gallery-next aria-label="Next image">→</button>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="fz-product__divider" aria-hidden="true"></div>

    <div class="fz-product__panel">
      <div class="fz-product__header">
        <div class="fz-product__headline">
          <h1 class="fz-product__title">{{ product_title_short }}</h1>
          {%- if product_title_detail != blank -%}
            <p class="fz-product__subtitle">{{ product_title_detail }}</p>
          {%- endif -%}
        </div>
        <p class="fz-product__price" data-product-price>{{ variant.price | money }}</p>
      </div>

      {%- if section.settings.show_reviews -%}
        <div class="fz-product__rating">
          <div class="fz-product__stars" aria-label="{{ section.settings.rating }} out of 5 stars">
            {%- assign rating_floor = section.settings.rating | floor -%}
            {%- for i in (1..5) -%}
              <span class="fz-product__star{% if i <= rating_floor %} is-filled{% endif %}">★</span>
            {%- endfor -%}
          </div>
          {%- if section.settings.review_count != blank -%}
            <a class="fz-product__reviews-link" href="{{ section.settings.reviews_link | default: '#reviews' }}">
              {{ section.settings.review_count }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- form 'product', product, data-fz-atc-form: '', data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ variant.id }}">

        <div class="fz-product__field" data-buy-area>
          <span class="fz-product__field-label">Quantity:</span>
          <div class="fz-qty fz-qty--editorial">
            <button type="button" class="fz-qty__btn" data-qty-change="-1" aria-label="Decrease quantity">−</button>
            <span class="fz-qty__num" data-qty-num>1</span>
            <button type="button" class="fz-qty__btn" data-qty-change="1" aria-label="Increase quantity">+</button>
            <input type="hidden" name="quantity" value="1" data-qty-input>
          </div>
        </div>

        {%- if desc_html != blank -%}
          <div class="fz-product__field fz-product__field--desc">
            <span class="fz-product__field-label">Description:</span>
            <div class="fz-product__desc-wrap" data-readmore>
              <div class="fz-product__desc" data-readmore-content>{{ desc_html }}</div>
              <button type="button" class="fz-product__read-more" data-readmore-toggle hidden>Read more</button>
            </div>
          </div>
        {%- endif -%}

        {%- unless product.has_only_default_variant -%}
          <div class="fz-product__options">
            {%- for option in product.options_with_values -%}
              <div class="fz-product__field fz-product__field--option">
                <span class="fz-product__field-label">{{ option.name }}:</span>
                <div class="fz-option-pills fz-option-pills--editorial">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="fz-option-pill{% if option.selected_value == value %} is-selected{% endif %}"
                      data-option-position="{{ option.position }}"
                      data-option-value="{{ value | escape }}"
                      aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                    >{{ value }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <div class="fz-buy fz-buy--editorial">
          {%- if variant.available -%}
            <button type="submit" class="fz-atc fz-atc--ghost">
              Add to cart
              <span class="visually-hidden" data-atc-price data-unit-price="{{ variant.price }}">{{ variant.price | money }}</span>
            </button>
          {%- else -%}
            <button type="button" class="fz-atc fz-atc--ghost" disabled>Sold out</button>
          {%- endif -%}
        </div>
      {%- endform -%}

      {%- if benefits != blank -%}
        <div class="fz-benefits fz-benefits--editorial">
          {%- for b in benefits -%}
            <div class="fz-benefits__row"><span class="fz-diamond">◆</span><span>{{ b }}</span></div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="fz-product__trust">
        {%- if section.settings.trust_1 != blank -%}<span class="fz-product__trust-item">{{ section.settings.trust_1 }}</span>{%- endif -%}
        {%- if section.settings.trust_2 != blank -%}<span class="fz-product__trust-item">{{ section.settings.trust_2 }}</span>{%- endif -%}
        {%- if section.settings.trust_3 != blank -%}<span class="fz-product__trust-item">{{ section.settings.trust_3 }}</span>{%- endif -%}
      </div>

      {%- if badges != blank -%}
        <div class="fz-badges">
          {%- for bd in badges -%}
            <span class="fz-badge">✓ {{ bd }}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="fz-accordions fz-accordions--editorial">
        {%- if how_to != blank -%}
          <div class="fz-acc">
            <button type="button" class="fz-acc__toggle" data-acc-toggle aria-expanded="false">
              <span>How to use</span><span class="fz-acc__sym">+</span>
            </button>
            <div class="fz-acc__body">
              {%- for step in how_to -%}
                <div class="fz-acc__line"><span class="fz-acc__n">{{ forloop.index }}.</span><span>{{ step }}</span></div>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
        <div class="fz-acc">
          <button type="button" class="fz-acc__toggle" data-acc-toggle aria-expanded="false">
            <span>Shipping & returns</span><span class="fz-acc__sym">+</span>
          </button>
          <div class="fz-acc__body">
            <div class="fz-acc__line"><span class="fz-acc__n">·</span><span>{{ section.settings.shipping_text }}</span></div>
            <div class="fz-acc__line"><span class="fz-acc__n">·</span><span><a href="{{ shop.refund_policy.url | default: '/policies/refund-policy' }}">View return policy</a></span></div>
          </div>
        </div>
        <div class="fz-acc">
          <button type="button" class="fz-acc__toggle" data-acc-toggle aria-expanded="false">
            <span>Good to know</span><span class="fz-acc__sym">+</span>
          </button>
          <div class="fz-acc__body">
            <div class="fz-acc__line"><span class="fz-acc__n">·</span><span>Consistency unlocks the best results — make it part of your ritual.</span></div>
            <div class="fz-acc__line"><span class="fz-acc__n">·</span><span>Do not use on irritated or broken skin; stop if irritation persists.</span></div>
            <div class="fz-acc__line"><span class="fz-acc__n">·</span><span>{% if size != blank %}{{ size }} · {% endif %}Product by Fauz Cosmetics.</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="fz-product__details">
    <div class="fz-product__details-grid">
      <div class="fz-product__detail-card">
        <h3 class="fz-product__detail-title">Quality</h3>
        <p class="fz-product__detail-text">{{ section.settings.detail_quality }}</p>
      </div>
      <div class="fz-product__detail-card">
        <h3 class="fz-product__detail-title">Routine</h3>
        <p class="fz-product__detail-text">{{ section.settings.detail_routine }}</p>
      </div>
      <div class="fz-product__detail-card">
        <h3 class="fz-product__detail-title">Support</h3>
        <p class="fz-product__detail-text">{{ section.settings.detail_support }}</p>
      </div>
    </div>
  </div>

  {%- liquid
    assign related_handles = ''
    assign related_count = 0
    if product_collection != blank
      for p in product_collection.products
        if p.id != product.id and related_count < 3
          assign related_handles = related_handles | append: p.handle | append: ','
          assign related_count = related_count | plus: 1
        endif
      endfor
    endif
    if related_count < 3
      for p in collections.all.products
        assign already = related_handles | split: ','
        unless p.id == product.id or already contains p.handle
          if related_count < 3
            assign related_handles = related_handles | append: p.handle | append: ','
            assign related_count = related_count | plus: 1
          endif
        endunless
      endfor
    endif
    assign related_list = related_handles | split: ','
  -%}

  {%- if related_count > 0 -%}
    <div class="fz-related">
      <h2 class="fz-related__title">{{ section.settings.related_heading }}</h2>
      <div class="fz-grid-3">
        {%- for h in related_list -%}
          {%- if h != blank -%}
            {% render 'product-card', card_product: all_products[h], show_sub: false %}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script type="application/json" id="FzProductVariants">{{ product.variants | json }}</script>

<div class="fz-sticky-atc" data-sticky-atc aria-hidden="true">
  <div class="fz-sticky-atc__inner">
    <div>
      <p class="fz-sticky-atc__title">{{ product.title }}</p>
      <p class="fz-sticky-atc__price"><span data-sticky-atc-price>{{ variant.price | money }}</span></p>
    </div>
    <button type="button" class="fz-sticky-atc__btn" data-sticky-atc-trigger{% unless variant.available %} disabled{% endunless %}>
      {%- if variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "header",
      "content": "Reviews"
    },
    {
      "type": "checkbox",
      "id": "show_reviews",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "range",
      "id": "rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Star rating",
      "default": 5
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count label",
      "default": "27 reviews"
    },
    {
      "type": "url",
      "id": "reviews_link",
      "label": "Reviews link"
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "Related products heading",
      "default": "Pairs well with"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust line 1",
      "default": "Cruelty-free"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust line 2",
      "default": "Clinically considered"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust line 3",
      "default": "Secure checkout"
    },
    {
      "type": "textarea",
      "id": "shipping_text",
      "label": "Shipping note",
      "default": "Orders ship within 1–2 business days. Tracking provided once dispatched."
    },
    {
      "type": "textarea",
      "id": "detail_quality",
      "label": "Quality detail",
      "default": "Developed with modern actives and barrier-conscious formulations."
    },
    {
      "type": "textarea",
      "id": "detail_routine",
      "label": "Routine detail",
      "default": "Designed for daily use as part of a simple, consistent skincare ritual."
    },
    {
      "type": "textarea",
      "id": "detail_support",
      "label": "Support detail",
      "default": "Questions? Visit our FAQ or contact us — we're here to help."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ]
}
{% endschema %}
