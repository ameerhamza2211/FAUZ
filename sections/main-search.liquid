{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}

{% render 'fz-page-hero',
  eyebrow: 'Search',
  title: 'Find your ritual',
  text: 'Explore cleansers, treatments, sun care, and more.',
  tone: 'default',
  compact: true
%}

<div class="fz-page-shell"{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %} data-page-reveal>
  <form action="{{ routes.search_url }}" method="get" role="search" class="fz-search-bar">
    <input
      class="fz-input"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="Search products"
      aria-label="Search"
    >
    <button type="submit" class="fz-btn fz-btn--primary fz-btn--primary-accent">Search</button>
  </form>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <p class="fz-empty-note">No results for “{{ search.terms | escape }}”.</p>
    {%- else -%}
      <p class="fz-collection__count" style="margin-bottom: 24px;">{{ search.results_count }} results</p>
      {%- paginate search.results by 24 -%}
        <div class="fz-collection__grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', card_product: item %}
            {%- else -%}
              <div class="fz-card">
                <div class="fz-card__info">
                  <div class="fz-card__name"><a href="{{ item.url }}">{{ item.title }}</a></div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="fz-pagination" aria-label="Pagination">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Prev</a>{%- endif -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ]
}
{% endschema %}
