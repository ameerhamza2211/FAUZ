{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}
<section class="fz-newsletter"{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %}>
  <div class="fz-newsletter__inner">
    <h2 class="fz-newsletter__title">{{ section.settings.heading }}</h2>
    <p class="fz-newsletter__text">{{ section.settings.text }}</p>
    {%- form 'customer', class: 'fz-newsletter__formwrap' -%}
      {%- if form.posted_successfully? -%}
        <div class="fz-newsletter__success">{{ section.settings.success_text }}</div>
      {%- else -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="fz-newsletter__form">
          <input
            type="email"
            name="contact[email]"
            id="NewsletterEmail-{{ section.id }}"
            class="fz-newsletter__input"
            placeholder="Email address"
            aria-label="Email address"
            autocomplete="email"
            required
          >
          <button type="submit" class="fz-newsletter__btn">Sign up</button>
        </div>
        {%- if form.errors -%}
          <div class="fz-newsletter__error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</div>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the ritual"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Exclusive deals and early access to new products. No noise."
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Welcome to FAUZ — you're on the list."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
