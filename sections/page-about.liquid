{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}

<div class="fz-page-shell fz-page-shell--about"{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %}>
  <h1 class="visually-hidden">{{ page.title | default: section.settings.heading }}</h1>
  <section class="fz-about-brand" data-page-reveal>
    <div class="fz-about-brand__layout">
      <div class="fz-about-brand__gallery">
        <div class="fz-about-brand__main">
          {%- if section.settings.badge_text != blank -%}
            <span class="fz-about-brand__badge">{{ section.settings.badge_text }}</span>
          {%- endif -%}
          {%- if section.settings.main_image != blank -%}
            {{ section.settings.main_image
              | image_url: width: 1200
              | image_tag: class: 'fz-about-brand__main-img', widths: '600, 900, 1200', loading: 'lazy', alt: section.settings.story_heading }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'fz-about-brand__main-img fz-about-brand__placeholder' }}
          {%- endif -%}
        </div>

        {%- if section.settings.inset_image != blank -%}
          <div class="fz-about-brand__inset">
            {{ section.settings.inset_image
              | image_url: width: 600
              | image_tag: class: 'fz-about-brand__inset-img', widths: '300, 450, 600', loading: 'lazy', alt: section.settings.story_heading }}
          </div>
        {%- endif -%}
      </div>

      <div class="fz-about-brand__content">
        {%- if section.settings.story_eyebrow != blank -%}
          <p class="fz-about-brand__eyebrow">
            <span class="fz-about-brand__eyebrow-line" aria-hidden="true"></span>
            {{ section.settings.story_eyebrow }}
          </p>
        {%- endif -%}

        {%- if section.settings.story_heading != blank -%}
          <h2 class="fz-about-brand__heading">{{ section.settings.story_heading }}</h2>
        {%- endif -%}

        {%- if section.settings.story_text != blank -%}
          <div class="fz-about-brand__prose fz-prose">{{ section.settings.story_text }}</div>
        {%- endif -%}

        {%- if section.settings.stat_1_value != blank or section.settings.stat_2_value != blank or section.settings.stat_3_value != blank -%}
          <div class="fz-about-brand__stats">
            {%- if section.settings.stat_1_value != blank -%}
              <div class="fz-about-brand__stat">
                <p class="fz-about-brand__stat-value">{{ section.settings.stat_1_value }}</p>
                <p class="fz-about-brand__stat-label">{{ section.settings.stat_1_label }}</p>
              </div>
            {%- endif -%}
            {%- if section.settings.stat_2_value != blank -%}
              <div class="fz-about-brand__stat">
                <p class="fz-about-brand__stat-value">{{ section.settings.stat_2_value }}</p>
                <p class="fz-about-brand__stat-label">{{ section.settings.stat_2_label }}</p>
              </div>
            {%- endif -%}
            {%- if section.settings.stat_3_value != blank -%}
              <div class="fz-about-brand__stat">
                <p class="fz-about-brand__stat-value">{{ section.settings.stat_3_value }}</p>
                <p class="fz-about-brand__stat-label">{{ section.settings.stat_3_label }}</p>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- assign brand_values = section.blocks | where: 'type', 'brand_value' -%}
        {%- if brand_values.size > 0 -%}
          <ul class="fz-about-brand__values">
            {%- for block in brand_values -%}
              <li class="fz-about-brand__value" {{ block.shopify_attributes }}>
                <span class="fz-about-brand__value-icon">
                  {% render 'fz-about-icon', icon: block.settings.icon %}
                </span>
                <div class="fz-about-brand__value-copy">
                  <h3 class="fz-about-brand__value-title">{{ block.settings.title }}</h3>
                  <p class="fz-about-brand__value-text">{{ block.settings.text }}</p>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a class="fz-btn fz-btn--primary fz-about-brand__cta" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            <span>{{ section.settings.button_label }}</span>
            <span class="fz-about-brand__cta-arrow" aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- for block in section.blocks -%}
    {%- if block.type == 'story' -%}
      {%- liquid
        assign reverse = false
        if block.settings.layout == 'image_right'
          assign reverse = true
        endif
      -%}
      <article class="fz-about-story{% if reverse %} fz-about-story--reverse{% endif %}" data-page-reveal {{ block.shopify_attributes }}>
        <div class="fz-about-story__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 1000 | image_tag: class: 'fz-about-story__img', loading: 'lazy', alt: block.settings.heading }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'fz-about-story__img' }}
          {%- endif -%}
        </div>
        <div class="fz-about-story__copy">
          {%- if block.settings.eyebrow != blank -%}
            <p class="fz-eyebrow">{{ block.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="fz-about-story__heading">{{ block.settings.heading }}</h2>
          <p class="fz-about-value__text">{{ block.settings.text }}</p>
          {%- if block.settings.button_label != blank -%}
            <a class="fz-btn fz-btn--outline" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>
      </article>
    {%- endif -%}
  {%- endfor -%}

  {%- if section.settings.quote != blank -%}
    <blockquote class="fz-about-quote" data-page-reveal>
      <p class="fz-about-quote__text">
        {{ section.settings.quote }}
        {%- if section.settings.quote_script != blank -%}
          <span class="fz-about-quote__script">{{ section.settings.quote_script }}</span>
        {%- endif -%}
      </p>
    </blockquote>
  {%- endif -%}

  {%- if page.content != blank -%}
    <div class="fz-prose fz-about-brand__page-content" data-page-reveal>{{ page.content }}</div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "About page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Hero eyebrow",
      "default": "About"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "default": "About Fauz"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Hero intro",
      "default": "Skincare designed for real routines — clean, considered, and made for skin that is uniquely yours."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "select",
      "id": "hero_tone",
      "label": "Hero tone",
      "options": [
        { "value": "default", "label": "Off-white" },
        { "value": "mint", "label": "Mint" }
      ],
      "default": "mint"
    },
    {
      "type": "header",
      "content": "Brand story section"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Image badge",
      "default": "Clean beauty"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main image"
    },
    {
      "type": "image_picker",
      "id": "inset_image",
      "label": "Inset image"
    },
    {
      "type": "text",
      "id": "story_eyebrow",
      "label": "Story eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story heading",
      "default": "Born from a love of considered skin"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story text",
      "default": "<p>Fauz was built on a simple belief: skincare should feel personal, not prescriptive. We create clinically considered formulas that respect your barrier, support consistency, and leave room for you to feel like yourself.</p><p>Every texture, active, and ritual is chosen for modern skin — lightweight, thoughtful, and made for the routines you will actually keep.</p>"
    },
    {
      "type": "header",
      "content": "Statistics"
    },
    {
      "type": "text",
      "id": "stat_1_value",
      "label": "Stat 1 value",
      "default": "12+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 label",
      "default": "Considered formulas"
    },
    {
      "type": "text",
      "id": "stat_2_value",
      "label": "Stat 2 value",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 label",
      "default": "Cruelty-free"
    },
    {
      "type": "text",
      "id": "stat_3_value",
      "label": "Stat 3 value",
      "default": "500+"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 label",
      "default": "Happy customers"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover our collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Closing quote"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "Nothing more. Nothing less."
    },
    {
      "type": "text",
      "id": "quote_script",
      "label": "Script line",
      "default": "Just you."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "brand_value",
      "name": "Brand value",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "clinical", "label": "Clinical" },
            { "value": "clean", "label": "Clean" },
            { "value": "personal", "label": "Personal" },
            { "value": "leaf", "label": "Natural" },
            { "value": "heart", "label": "Community" },
            { "value": "craft", "label": "Craft" }
          ],
          "default": "clinical"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Clinically considered" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Performance-first formulas developed with modern skin in mind." }
      ]
    },
    {
      "type": "story",
      "name": "Story block",
      "settings": [
        { "type": "select", "id": "layout", "label": "Layout", "options": [
          { "value": "image_left", "label": "Image left" },
          { "value": "image_right", "label": "Image right" }
        ], "default": "image_right" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Made for modern skin" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "We design for daily use — lightweight textures, thoughtful actives, and rituals you'll actually keep." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About page",
      "blocks": [
        { "type": "brand_value", "settings": { "icon": "clinical", "title": "Clinically considered", "text": "Performance-first formulas developed with modern skin in mind." } },
        { "type": "brand_value", "settings": { "icon": "clean", "title": "Clean & conscious", "text": "Paraben-free, cruelty-free, and designed for consistent daily use." } },
        { "type": "brand_value", "settings": { "icon": "personal", "title": "Uniquely yours", "text": "We never ask you to compare — your ritual should feel personal." } }
      ]
    }
  ]
}
{% endschema %}
