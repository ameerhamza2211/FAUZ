{%- capture fz_showcase_spacing -%}{%- render 'fz-section-padding', section: section, output: 'variables', scope: 'showcase' -%}{%- endcapture -%}
<section class="fz-showcase" data-showcase id="products"{% if fz_showcase_spacing != blank %} style="{{ fz_showcase_spacing | strip }}"{% endif %}>
  <div class="fz-showcase__pin">
    <div class="fz-showcase__intro">
      <p class="fz-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="fz-showcase__heading">{{ section.settings.heading }}</h2>
      <div class="fz-showcase__counter" data-showcase-counter aria-hidden="true">
        <span data-showcase-current>01</span>
        <span class="fz-showcase__counter-sep">/</span>
        <span data-showcase-total>01</span>
      </div>
    </div>

    <div class="fz-showcase__stage">
      <div class="fz-showcase__track" data-showcase-track>
        {%- liquid
          assign limit = section.settings.products_to_show
          assign slide_index = 0
        -%}

        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks limit: limit -%}
            {%- if block.settings.product != blank -%}
              {% render 'showcase-product', card_product: block.settings.product, index: slide_index, block: block %}
              {%- assign slide_index = slide_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- elsif section.settings.collection != blank -%}
          {%- for product in section.settings.collection.products limit: limit -%}
            {% render 'showcase-product', card_product: product, index: slide_index %}
            {%- assign slide_index = slide_index | plus: 1 -%}
          {%- endfor -%}
        {%- else -%}
          {%- for product in collections.all.products limit: limit -%}
            {% render 'showcase-product', card_product: product, index: slide_index %}
            {%- assign slide_index = slide_index | plus: 1 -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <div class="fz-showcase__mobile-nav" data-showcase-mobile-nav aria-label="Product slider navigation">
      <button type="button" class="fz-showcase__nav-btn" data-showcase-prev aria-label="Previous product">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M11 4L6 9L11 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button type="button" class="fz-showcase__nav-btn" data-showcase-next aria-label="Next product">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M7 4L12 9L7 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Formulas worth the ritual"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when no product blocks are added."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Product showcase" }]
}
{% endschema %}
