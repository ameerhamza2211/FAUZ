{%- capture fz_section_padding -%}{%- render 'fz-section-padding', section: section -%}{%- endcapture -%}
<section class="fz-promise"{% if fz_section_padding != blank %} style="{{ fz_section_padding | strip }}"{% endif %}>
  <div class="fz-promise__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="fz-eyebrow fz-promise__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.quote != blank -%}
      <h2 class="fz-promise__quote">
        <span class="fz-promise__quote-mark" aria-hidden="true">&ldquo;</span>
        <span class="fz-promise__quote-text">{{ section.settings.quote }}</span>
        <span class="fz-promise__quote-mark" aria-hidden="true">&rdquo;</span>
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="fz-promise__claims">
        {%- for block in section.blocks -%}
          <span class="fz-promise__claim" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Our promise",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our promise"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "Your skin is as unique as you are. We formulate for that — nothing more, nothing less."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0,
      "info": "0 keeps the theme default spacing."
    }
  ],
  "blocks": [
    {
      "type": "claim",
      "name": "Claim",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Paraben-free" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Our promise",
      "blocks": [
        { "type": "claim", "settings": { "text": "Paraben-free" } },
        { "type": "claim", "settings": { "text": "Cruelty-free" } },
        { "type": "claim", "settings": { "text": "Non-comedogenic" } },
        { "type": "claim", "settings": { "text": "All skin types" } }
      ]
    }
  ]
}
{% endschema %}
