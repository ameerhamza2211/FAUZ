{%- comment -%}
  Contact page icons.
  @param icon {string} location | email | phone | clock | instagram | facebook | tiktok | whatsapp | telegram | youtube
{%- endcomment -%}

{%- case icon -%}
  {%- when 'location' -%}
    <svg class="fz-contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 21s7-4.5 7-11a7 7 0 1 0-14 0c0 6.5 7 11 7 11Z" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.5"/>
    </svg>
  {%- when 'email' -%}
    <svg class="fz-contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
      <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'phone' -%}
    <svg class="fz-contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M6.5 4h3l1.5 4-2 1.5a11 11 0 0 0 5 5L17.5 12 21.5 13.5V17a2 2 0 0 1-2 2C10.5 19 5 13.5 5 6.5A2 2 0 0 1 6.5 4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
  {%- when 'clock' -%}
    <svg class="fz-contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5"/>
      <path d="M12 8v4l3 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'instagram' -%}
    <svg class="fz-contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.5"/>
      <circle cx="17" cy="7" r="1" fill="currentColor"/>
    </svg>
  {%- when 'facebook' -%}
    <svg class="fz-contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M14 8h2V5h-2c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h2.5l.5-3H13V9c0-.6.4-1 1-1Z" fill="currentColor"/>
    </svg>
  {%- when 'tiktok' -%}
    <svg class="fz-contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M15 5c.5 2.2 2 3.8 4.5 4v3.2c-1.7 0-3.2-.5-4.5-1.4V16a5.5 5.5 0 1 1-5.5-5.5c.3 0 .7 0 1 .1v3.2a2.3 2.3 0 1 0 1.7 2.2V5H15Z" fill="currentColor"/>
    </svg>
  {%- when 'whatsapp' -%}
    <svg class="fz-contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 4a8 8 0 0 0-6.9 12.1L4 20l3.9-1A8 8 0 1 0 12 4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M9.5 9.5c.3-.7.5-.7.9-.7h.7c.2 0 .4.1.5.4l.5 1.2c.1.2 0 .5-.2.6l-.6.5c.4.8 1 1.4 1.8 1.8l.5-.6c.2-.2.4-.2.6-.1l1.2.5c.3.1.4.3.4.5v.7c0 .4 0 .6-.7.9-1 .4-2.1-.1-3.4-1.4S9.1 10.5 9.5 9.5Z" fill="currentColor"/>
    </svg>
  {%- when 'telegram' -%}
    <svg class="fz-contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M5 12.5 18.5 7 20 7.5 17 19l-3-5.5-4.5 3.5V11l8-6.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
  {%- when 'youtube' -%}
    <svg class="fz-contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="3" y="6" width="18" height="12" rx="3" stroke="currentColor" stroke-width="1.5"/>
      <path d="m11 10 4 2-4 2v-4Z" fill="currentColor"/>
    </svg>
  {%- else -%}
    <svg class="fz-contact-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.5"/>
      <path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
{%- endcase -%}
