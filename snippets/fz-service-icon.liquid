{%- comment -%}
  @param icon {string} shipping | returns | support | payment
{%- endcomment -%}

{%- case icon -%}
  {%- when 'returns' -%}
    <svg class="fz-service-highlights__icon-svg" viewBox="0 0 40 40" fill="none" aria-hidden="true">
      <path d="M10 15h18a5 5 0 0 1 0 10H22" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M15 10 10 15l5 5" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'support' -%}
    <svg class="fz-service-highlights__icon-svg" viewBox="0 0 40 40" fill="none" aria-hidden="true">
      <path d="M20 34c7.732 0 14-5.082 14-11.5V14l-14-6-14 6v8.5C6 28.918 12.268 34 20 34Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/>
      <path d="M15.5 19h.01M24.5 19h.01M16 23.5a4 4 0 0 0 8 0" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
    </svg>
  {%- when 'payment' -%}
    <svg class="fz-service-highlights__icon-svg" viewBox="0 0 40 40" fill="none" aria-hidden="true">
      <rect x="5" y="11" width="30" height="19" rx="3" stroke="currentColor" stroke-width="1.35"/>
      <path d="M5 17h30" stroke="currentColor" stroke-width="1.35"/>
      <path d="M11 24h6" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
    </svg>
  {%- else -%}
    <svg class="fz-service-highlights__icon-svg" viewBox="0 0 40 40" fill="none" aria-hidden="true">
      <path d="M8 14h24l-2-7H10l-2 7Z" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/>
      <path d="M8 14v12a3 3 0 0 0 3 3h18a3 3 0 0 0 3-3V14" stroke="currentColor" stroke-width="1.35" stroke-linejoin="round"/>
      <path d="M20 19v8" stroke="currentColor" stroke-width="1.35" stroke-linecap="round"/>
    </svg>
{%- endcase -%}
