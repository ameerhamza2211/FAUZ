{%- comment -%}
  @param icon {string} shipping | returns | support | payment
{%- endcomment -%}

{%- case icon -%}
  {%- when 'returns' -%}
    <svg class="fz-service-highlights__icon-svg" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <path d="M8 12h14.5a4.5 4.5 0 0 1 0 9H18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M12 8 8 12l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'support' -%}
    <svg class="fz-service-highlights__icon-svg" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <path d="M16 28c6.627 0 12-4.477 12-10V11.5L16 6 4 11.5V18c0 5.523 5.373 10 12 10Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M12.5 15.5h.01M19.5 15.5h.01M12.8 19.2a3.2 3.2 0 0 0 6.4 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- when 'payment' -%}
    <svg class="fz-service-highlights__icon-svg" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <rect x="4" y="9" width="24" height="16" rx="2.5" stroke="currentColor" stroke-width="1.5"/>
      <path d="M4 14h24" stroke="currentColor" stroke-width="1.5"/>
      <path d="M9 20h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  {%- else -%}
    <svg class="fz-service-highlights__icon-svg" viewBox="0 0 32 32" fill="none" aria-hidden="true">
      <path d="M16 26V14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M10 14h12l-1.2-5.5A2 2 0 0 0 18.84 7H13.16a2 2 0 0 0-1.96 1.5L10 14Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
      <path d="M8 14h16v2.5a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 8 16.5V14Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
    </svg>
{%- endcase -%}
