{% comment %}
  FAUZ logo lockup: wordmark + "YOU ARE Unique" script line.
  Accepts:
    footer (boolean) — larger footer variant
    header (boolean) — compact header variant without duplicate wrapper class
{% endcomment %}
<span class="{% if footer %}fz-footer__logo{% elsif header %}fz-header__logo-mark{% else %}fz-logo{% endif %}">
  <span class="fz-logo__word">FAUZ</span>
  <span class="fz-logo__tag">
    <span class="fz-logo__youare">You are</span>
    <span class="fz-logo__script">Unique</span>
  </span>
</span>
