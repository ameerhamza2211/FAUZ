{%- comment -%}
  FAUZ logo lockup — brand PNG (FAUZ + YOU ARE Unique) or theme setting override.

  Accepts:
    footer {boolean} — footer variant
    header {boolean} — compact header variant
    giant {boolean} — large footer wordmark
    show_tagline {boolean} — text tagline fallback when no image is used
{%- endcomment -%}

{%- liquid
  assign show_tag = show_tagline
  if show_tag == nil
    assign show_tag = true
  endif

  if giant
    assign root_class = 'fz-logo fz-logo--giant'
  elsif footer
    assign root_class = 'fz-footer__logo'
  elsif header
    assign root_class = 'fz-header__logo-mark'
  else
    assign root_class = 'fz-logo'
  endif

  assign tag_you = settings.tagline_you | default: 'YOU ARE'
  assign tag_script = settings.tagline_script | default: 'Unique'

  assign logo_image = settings.logo
  assign use_logo_image = true
  if logo_image != blank
    assign logo_alt = logo_image.alt | default: shop.name
  else
    assign logo_alt = shop.name
  endif
-%}

<span class="{{ root_class }}{% if use_logo_image %} fz-logo--image{% endif %}">
  {%- if use_logo_image -%}
    <span class="fz-logo__mark">
      {%- if logo_image != blank -%}
        {%- if giant -%}
          {{ logo_image
            | image_url: width: 1200
            | image_tag:
              class: 'fz-logo__img',
              widths: '400, 800, 1200',
              loading: 'lazy',
              alt: logo_alt }}
        {%- else -%}
          {{ logo_image
            | image_url: width: 480
            | image_tag:
              class: 'fz-logo__img',
              widths: '180, 280, 480',
              loading: 'eager',
              alt: logo_alt }}
        {%- endif -%}
      {%- else -%}
        <img
          class="fz-logo__img"
          src="{{ 'fauz-logo.png' | asset_url }}"
          alt="{{ logo_alt | escape }}"
          width="480"
          height="160"
          loading="{% if header %}eager{% else %}lazy{% endif %}"
        >
      {%- endif -%}
    </span>
  {%- else -%}
    <span class="fz-logo__word"{% if giant %} aria-hidden="true"{% endif %}>FAUZ</span>
  {%- endif -%}

  {%- if show_tag and use_logo_image == false -%}
    <span class="fz-logo__tag">
      <span class="fz-logo__youare">{{ tag_you }}</span>
      <span class="fz-logo__script">{{ tag_script }}</span>
    </span>
  {%- endif -%}
</span>
