{% comment %}
  Premium showcase slide for product-showcase section.
  Accepts: product (required), index (number), block (optional shopify block)
{% endcomment %}

{%- liquid
  assign slide_num = index | plus: 1
  if slide_num < 10
    assign slide_num_padded = slide_num | prepend: '0'
  else
    assign slide_num_padded = slide_num
  endif

  assign title_parts = card_product.title | split: ' – '
  if title_parts.size == 1
    assign title_parts = card_product.title | split: ' - '
  endif
  if title_parts.size > 1
    assign short_title = title_parts[0]
    assign title_detail = title_parts[1]
  else
    assign short_title = card_product.title
    assign title_detail = card_product.metafields.custom.subtitle.value
  endif

  assign tint = 'offwhite'
  for c in card_product.collections
    if c.handle == 'sun-care'
      assign tint = 'mint'
    endif
  endfor
  if card_product.metafields.custom.card_tint != blank
    assign tint = card_product.metafields.custom.card_tint
  endif
-%}

<article
  class="fz-showcase__slide"
  data-showcase-card
  data-showcase-index="{{ slide_num_padded }}"
  {% if block %}{{ block.shopify_attributes }}{% endif %}
>
  <div class="fz-showcase__slide-inner">
    <div class="fz-showcase__media{% if tint == 'mint' %} fz-showcase__media--mint{% endif %}">
      <a class="fz-showcase__media-link" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }}">
        {%- if card_product.featured_image -%}
          {{ card_product.featured_image
            | image_url: width: 1200, height: 1200, crop: 'center'
            | image_tag: class: 'fz-showcase__img', widths: '800, 1200, 1600', loading: 'lazy', alt: short_title }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'fz-showcase__img' }}
        {%- endif -%}
      </a>
    </div>

    <div class="fz-showcase__copy">
      <span class="fz-showcase__index">{{ slide_num_padded }}</span>
      <h3 class="fz-showcase__title">{{ short_title }}</h3>
      {%- if title_detail != blank -%}
        <p class="fz-showcase__detail">{{ title_detail }}</p>
      {%- endif -%}
      {%- if card_product.description != blank -%}
        <p class="fz-showcase__desc">{{ card_product.description | strip_html }}</p>
      {%- endif -%}
      <div class="fz-showcase__foot">
        <span class="fz-showcase__price">{{ card_product.price | money }}</span>
        {%- if card_product.available -%}
          <button
            type="button"
            class="fz-btn fz-btn--primary fz-btn--editorial fz-showcase__atc"
            data-quick-add="{{ card_product.selected_or_first_available_variant.id }}"
          >Add to cart</button>
        {%- else -%}
          <span class="fz-showcase__sold">Sold out</span>
        {%- endif -%}
      </div>
      <a class="fz-showcase__view" href="{{ card_product.url }}">View product</a>
    </div>
  </div>
</article>
