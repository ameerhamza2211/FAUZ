<div class="fz-page">
  <h1 class="fz-page__title">Activate account</h1>
  {% form 'activate_customer_password', class: 'fz-form' %}
    {% if form.errors %}<div class="fz-form__errors">{{ form.errors | default_errors }}</div>{% endif %}
    <input class="fz-input" type="password" name="customer[password]" placeholder="Password" autocomplete="new-password" required>
    <input class="fz-input" type="password" name="customer[password_confirmation]" placeholder="Confirm password" autocomplete="new-password" required>
    <div style="display: flex; gap: 12px;">
      <button type="submit" class="fz-btn fz-btn--primary fz-btn--primary-accent">Activate</button>
      <button type="submit" name="decline" class="fz-btn fz-btn--outline">Decline</button>
    </div>
  {% endform %}
</div>
