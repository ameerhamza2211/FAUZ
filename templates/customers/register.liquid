<div class="fz-page">
  <h1 class="fz-page__title">Create account</h1>
  {% form 'create_customer', class: 'fz-form' %}
    {% if form.errors %}<div class="fz-form__errors">{{ form.errors | default_errors }}</div>{% endif %}
    <input class="fz-input" type="text" name="customer[first_name]" placeholder="First name" autocomplete="given-name">
    <input class="fz-input" type="text" name="customer[last_name]" placeholder="Last name" autocomplete="family-name">
    <input class="fz-input" type="email" name="customer[email]" placeholder="Email" autocomplete="email" required>
    <input class="fz-input" type="password" name="customer[password]" placeholder="Password" autocomplete="new-password" required>
    <div><button type="submit" class="fz-btn fz-btn--primary fz-btn--primary-accent">Create account</button></div>
    <p class="fz-empty-note"><a href="{{ routes.account_login_url }}">Already have an account? Log in</a></p>
  {% endform %}
</div>
