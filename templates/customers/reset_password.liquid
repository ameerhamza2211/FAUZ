<div class="fz-page">
  <h1 class="fz-page__title">Reset password</h1>
  {% form 'reset_customer_password', class: 'fz-form' %}
    {% if form.errors %}<div class="fz-form__errors">{{ form.errors | default_errors }}</div>{% endif %}
    <input class="fz-input" type="password" name="customer[password]" placeholder="New password" autocomplete="new-password" required>
    <input class="fz-input" type="password" name="customer[password_confirmation]" placeholder="Confirm password" autocomplete="new-password" required>
    <div><button type="submit" class="fz-btn fz-btn--primary fz-btn--primary-accent">Reset password</button></div>
  {% endform %}
</div>
